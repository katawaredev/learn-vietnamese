# Server-only configuration. Never prefix these keys with VITE_.
# BASE_URL includes the API prefix, usually /v1, without /audio/speech etc.
# Leave a complete group empty to disable it. API_KEY is optional for local services.

AI_TTS_VN_BASE_URL=
AI_TTS_VN_MODEL=
AI_TTS_VN_VOICE=
AI_TTS_VN_API_KEY=

AI_TTS_EN_BASE_URL=
AI_TTS_EN_MODEL=
AI_TTS_EN_VOICE=
AI_TTS_EN_API_KEY=

AI_STT_BASE_URL=
AI_STT_MODEL=
AI_STT_API_KEY=

AI_CHAT_BASE_URL=
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
# Additional installed models, comma-separated; only these and AI_CHAT_MODEL are selectable.
AI_CHAT_MODELS=
# Optional thinking controls: ollama (reasoning_effort), qwen (chat_template_kwargs).
# Leave empty for services/models that do not support thinking controls.
AI_CHAT_THINKING=
