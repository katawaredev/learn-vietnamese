{
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"tsdk": "./node_modules/typescript/lib"
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "deny"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": "./vite.config.ts",
					"run": "onSave"
				}
			}
		}
	},
	"languages": {
		"TypeScript": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "oxfmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"JavaScript": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "oxfmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"TSX": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [
				{ "language_server": { "name": "oxfmt" } },
				{ "code_action": "source.fixAll.oxc" }
			]
		},
		"MDX": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"Markdown": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"JSON": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "org": "oxfmt" } }]
		},
		"JSON5": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"JSONC": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"CSS": {
			"format_on_save": "on",
			"language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
			"prettier": { "allowed": false },
			"formatter": [{ "code_action": "source.fixAll.oxc" }]
		},
		"HTML": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"GraphQL": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "code_action": "source.fixAll.oxc" }]
		},
		"YAML": {
			"format_on_save": "on",
			"language_servers": ["..."],
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "org": "oxfmt" } }]
		}
	}
}
