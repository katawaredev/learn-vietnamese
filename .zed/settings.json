{
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"tsdk": "./node_modules/typescript/lib"
				},
				"vtsls": {
					"autoUseWorkspaceTsdk": true
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "deny",
					"configPath": "./vite.config.ts"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": "./vite.config.ts",
					"run": "onSave"
				}
			}
		},
		"tailwindcss-language-server": {
			"settings": {
				"tailwindCSS": {
					"validate": false,
					"classFunctions": ["cva", "cx", "twMerge", "clsx", "cn"]
				}
			}
		}
	},
	"languages": {
		"TypeScript": {
			"format_on_save": "on",
			"language_servers": ["vtsls", "oxlint", "oxfmt", "tailwindcss-language-server"],
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JavaScript": {
			"format_on_save": "on",
			"language_servers": ["vtsls", "oxlint", "oxfmt", "tailwindcss-language-server"],
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"TSX": {
